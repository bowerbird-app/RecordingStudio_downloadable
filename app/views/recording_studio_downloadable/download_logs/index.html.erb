<% content_for :title, RecordingStudioDownloadable::Copy.t("history.title", default: RecordingStudioDownloadable::Copy::HISTORY_TITLE) %>

<%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg) do %>
  <%= render FlatPack::PageTitle::Component.new(
    title: RecordingStudioDownloadable::Copy.t("history.title", default: RecordingStudioDownloadable::Copy::HISTORY_TITLE),
    subtitle: RecordingStudioDownloadable::Copy.t("history.subtitle", default: RecordingStudioDownloadable::Copy::HISTORY_SUBTITLE),
    variant: :h1
  ) %>

  <%= render FlatPack::Grid::Component.new(cols: 3, gap: :md) do %>
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.body do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: @stats.total.to_s,
          subtitle: RecordingStudioDownloadable::Copy.t("history.all_time", default: RecordingStudioDownloadable::Copy::STATS_ALL_TIME),
          size: :lg,
          spacing: :none,
          level: :h2
        ) %>
      <% end %>
    <% end %>
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.body do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: @stats.last_30_days.to_s,
          subtitle: RecordingStudioDownloadable::Copy.t("history.last_30_days", default: RecordingStudioDownloadable::Copy::STATS_LAST_30_DAYS),
          size: :lg,
          spacing: :none,
          level: :h2
        ) %>
      <% end %>
    <% end %>
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.body do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: @stats.identified_people.to_s,
          subtitle: RecordingStudioDownloadable::Copy.t("history.people", default: RecordingStudioDownloadable::Copy::STATS_PEOPLE),
          size: :lg,
          spacing: :none,
          level: :h2
        ) %>
      <% end %>
    <% end %>
  <% end %>

  <%= form_with url: recording_download_logs_path(@recording), method: :get do %>
    <%= render FlatPack::Grid::Component.new(cols: 3, gap: :md) do %>
      <%= render FlatPack::DateRangeInput::Component.new(
        start_name: "from",
        end_name: "to",
        start_value: @filters.from,
        end_value: @filters.to,
        label: RecordingStudioDownloadable::Copy.t("history.when", default: RecordingStudioDownloadable::Copy::COLUMN_WHEN)
      ) %>
      <%= render FlatPack::Select::Component.new(
        name: "download",
        label: RecordingStudioDownloadable::Copy.t("history.download", default: RecordingStudioDownloadable::Copy::COLUMN_DOWNLOAD),
        options: @filters.download_choices,
        value: @filters.download
      ) %>
      <%= render FlatPack::Select::Component.new(
        name: "person",
        label: RecordingStudioDownloadable::Copy.t("history.who", default: RecordingStudioDownloadable::Copy::COLUMN_WHO),
        options: @filters.person_choices,
        value: @filters.person
      ) %>
    <% end %>
    <%= render FlatPack::Grid::Component.new(cols: 2, gap: :sm) do %>
      <%= render FlatPack::Button::Component.new(
        text: RecordingStudioDownloadable::Copy.t("history.filter", default: RecordingStudioDownloadable::Copy::FILTER_BUTTON),
        style: :primary,
        size: :md,
        type: "submit"
      ) %>
      <% if @filters.active? %>
        <%= render FlatPack::Button::Component.new(
          text: RecordingStudioDownloadable::Copy.t("history.clear", default: RecordingStudioDownloadable::Copy::CLEAR_BUTTON),
          style: :ghost,
          size: :md,
          href: recording_download_logs_path(@recording)
        ) %>
      <% end %>
    <% end %>
  <% end %>

  <% if @logs.empty? %>
    <%= render FlatPack::EmptyState::Component.new(
      title: RecordingStudioDownloadable::Copy.t("history.empty_title", default: RecordingStudioDownloadable::Copy::HISTORY_EMPTY_TITLE),
      description: RecordingStudioDownloadable::Copy.t("history.empty_body", default: RecordingStudioDownloadable::Copy::HISTORY_EMPTY_BODY),
      icon: :"arrow-down-tray"
    ) %>
  <% else %>
    <%= render FlatPack::Table::Component.new(data: @logs, min_width: :sm) do |table| %>
      <% table.column(title: RecordingStudioDownloadable::Copy.t("history.when", default: RecordingStudioDownloadable::Copy::COLUMN_WHEN), html: ->(log) { render(FlatPack::Timestamp::Component.new(timestamp: log.occurred_at)) }) %>
      <% table.column(title: RecordingStudioDownloadable::Copy.t("history.who", default: RecordingStudioDownloadable::Copy::COLUMN_WHO), html: ->(log) { log.person_label }) %>
      <% table.column(title: RecordingStudioDownloadable::Copy.t("history.download", default: RecordingStudioDownloadable::Copy::COLUMN_DOWNLOAD), html: ->(log) { log.action }) %>
    <% end %>
    <%= render FlatPack::Pagination::Component.new(pagy: @pagy) %>
  <% end %>
<% end %>
