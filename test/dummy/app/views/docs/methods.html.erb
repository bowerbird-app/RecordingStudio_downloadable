<% dummy_page_nav(title: "Methods", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Public recording API from RecordingStudio::Capabilities::Downloadable::RecordingMethods.",
    variant: :h1
  ) %>

  <p class="text-sm leading-6 text-(--surface-muted-content-color)">
    Installing the gem does not enable Downloadable. These methods are on recordings whose recordable type
    included <code>Downloadable.to</code>. <code>source: :attachments</code> uses direct Attachable children
    (original blobs, not variants; trashed attachments skipped). <code>source: :manifest</code> uses
    <code>#downloadable_manifest</code>. Empty file sets never produce a ZIP. Accessible <code>authorized_action?</code> gates every download endpoint.
  </p>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Opt-in and files",
    subtitle: "downloadable?, downloadable_files, downloadable_empty?"
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~CODE
      recording = RecordingStudio.root_recording_for(workspace)
      recording.downloadable?        # true when :downloadable is enabled for this recordable type
      recording.downloadable_files   # Array of DownloadFile (filename, content_type, byte_size, …)
      recording.downloadable_empty?  # true when the chosen source has no files
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Generate a ZIP",
    subtitle: "recording.downloadable_generate!"
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~CODE
      package = recording.downloadable_generate!(
        action: recording.downloadable_action,
        export_scope: recording.downloadable_export_scope
      )
      # Enqueues GeneratePackageJob. Returns nil when downloadable_empty?.
      # Reuses a ready/pending/processing package when the source fingerprint matches.
      # Hosts call this from their own subscribers (publish, first ZIP, and so on).
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Host subscribers",
    subtitle: "Downloadable stays independent of Publishable. Wire host events to the recording API."
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~CODE
      recording.downloadable_generate!(
        action: recording.downloadable_action,
        export_scope: recording.downloadable_export_scope
      )
      recording.downloadable_invalidate!(immediate: true)
      # Example only: RecordingStudio_publishable v0.7.0 emits
      # published.recording_studio_publishable and
      # unpublished.recording_studio_publishable.
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Package state",
    subtitle: "downloadable_package, downloadable_ready?"
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~CODE
      recording.downloadable_package  # Package row for recording + action + scope + format
      recording.downloadable_ready?
      recording.downloadable_stale?
      recording.downloadable_action
      recording.downloadable_invalidate!(immediate: true)
      # ready? is false when sources, action, or export scope changed (stale fingerprint).
      # Hosts call invalidate from their own unpublish/privacy subscribers. Downloadable
      # does not depend on Publishable.
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Download URL",
    subtitle: "recording.downloadable_download_path"
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~CODE
      recording.downloadable_download_path
      # Engine GET recording_package_path(recording)
      # Controller authorizes the recording's download action, then redirects
      # to a short-lived signed blob URL (bearer link until expiry, default 5
      # minutes). After POST generate, the button polls GET
      # recording_package_status_path until ready. Authorized actors
      # (including public anonymous) enqueue a missing or stale rebuild;
      # unauthorized requests never enqueue.
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Source and format",
    subtitle: "Values stored from Downloadable.to on this recordable type."
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~CODE
      recording.downloadable_source        # :attachments or :manifest
      recording.downloadable_format        # :zip
      recording.downloadable_action        # :"workspaces.download"
      recording.downloadable_export_scope  # :public
    CODE
  ) %>
</div>
