<% dummy_page_nav(title: "Methods", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Public recording methods from Downloadable.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Generate a ZIP",
    subtitle: "recording.downloadable_generate!",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      recording = RecordingStudio.root_recording_for(workspace)
      recording.downloadable_files
      recording.downloadable_generate!
      recording.downloadable_ready?
      recording.downloadable_download_path
    CODE
  ) %>

  <p class="text-sm text-(--body-muted-content-color)">
    Installing the gem does not enable Downloadable. Host recordables opt in with Downloadable.to.
  </p>
</div>
