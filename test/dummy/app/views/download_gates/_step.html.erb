<% if WorkspaceDownloadGate.confirmed?(WorkspaceDownloadGate.entry_for(recording, WorkspaceDownloadGate.entries(Current.download_gate))) %>
  <%= recording_studio_downloadable_button(recording, autostart: true) do %>
    <%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg, align: :start) do %>
      <div data-downloadable-progress>
        <%= render FlatPack::Grid::Component.new(cols: 1, gap: :sm, align: :start) do %>
          <%= render FlatPack::SectionTitle::Component.new(
            title: "Fetching your files…",
            size: :md,
            spacing: :none,
            level: :h3,
            data: { downloadable_progress_label: true }
          ) %>
          <%= render FlatPack::Progress::Component.new(
            value: 20,
            max: 100,
            size: :lg,
            label: "Fetching your files…",
            label_visible: false
          ) %>
        <% end %>
      </div>
      <div data-downloadable-started hidden>
        <%= render FlatPack::EmptyState::Component.new(
          title: "Download started",
          icon: false,
          size: :sm
        ) do |empty| %>
          <% empty.graphic do %>
            <%= render FlatPack::Shared::IconComponent.new(
              name: "check-circle",
              variant: :solid,
              size: :xl,
              class: "text-[var(--color-success-background-color)]"
            ) %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% else %>
  <%= form_with url: download_gate_path, method: :patch do %>
    <%= hidden_field_tag :recording_id, recording.id %>
    <%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg, align: :start) do %>
      <% if flash[:alert].present? %>
        <%= render FlatPack::Alert::Component.new(title: flash[:alert], style: :warning) %>
      <% end %>
      <%= render FlatPack::Checkbox::Component.new(
        name: "confirmed",
        label: "Send me the ZIP",
        help_text: "One check, then the files.",
        required: true
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Continue",
        style: :primary,
        size: :md,
        type: "submit"
      ) %>
    <% end %>
  <% end %>
<% end %>
