<% dummy_page_nav(title: "Downloadable Demo", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Downloadable Demo",
    subtitle: "Package a recording's Attachable files into a ZIP.",
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(
        title: @workspace&.name || "No workspace",
        subtitle: "Direct attachments only. Original files, not previews.",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>
    <% end %>

    <% card.body do %>
      <% if @recording %>
        <ul class="space-y-3 text-sm leading-6">
          <li>Downloadable: <%= @recording.downloadable? %></li>
          <li>Files: <%= @recording.downloadable_files.size %></li>
          <li>Ready: <%= @recording.downloadable_ready? %></li>
        </ul>
      <% else %>
        <p class="text-sm leading-6">Seed the dummy app to create Studio Workspace.</p>
      <% end %>
    <% end %>

    <% if @recording %>
      <% card.footer do %>
        <%= recording_studio_downloadable_button(@recording) %>
        <%= recording_studio_downloadable_history_link(@recording) %>
      <% end %>
    <% end %>
  <% end %>

  <% if @locked_recording %>
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Locked Workspace",
          subtitle: "No access here, so the download control asks instead.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.footer do %>
        <%= recording_studio_downloadable_button(@locked_recording) %>
      <% end %>
    <% end %>
  <% end %>

  <% if @gated_recording %>
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Gated Download",
          subtitle: "A couple of questions, then the files.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <%= recording_studio_downloadable_button(@gated_recording) %>
      <% end %>

      <% card.footer do %>
        <%= recording_studio_downloadable_history_link(@gated_recording) %>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(
        title: "Press kits",
        subtitle: "A mixed ZIP: uploaded files plus generated text and JSON.",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>
    <% end %>

    <% card.body do %>
      <p class="text-sm leading-6">
        Open Press kits to upload files, edit the description, and download the package.
      </p>
    <% end %>

    <% card.footer do %>
      <%= render FlatPack::Button::Component.new(
        text: "View press kits",
        style: :primary,
        size: :md,
        href: press_kits_path
      ) %>
    <% end %>
  <% end %>
</div>
