<% dummy_page_nav(title: "Downloadable Demo", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Downloadable Demo",
    subtitle: "Package a recording's Attachable files into a ZIP.",
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(
        title: @workspace&.name || "No workspace",
        subtitle: "Direct attachments only. Original files, not previews.",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>
    <% end %>

    <% card.body do %>
      <% if @recording %>
        <ul class="space-y-3 text-sm leading-6">
          <li>Downloadable: <%= @recording.downloadable? %></li>
          <li>Files: <%= @recording.downloadable_files.size %></li>
          <li>Ready: <%= @recording.downloadable_ready? %></li>
        </ul>
      <% else %>
        <p class="text-sm leading-6">Seed the dummy app to create Studio Workspace.</p>
      <% end %>
    <% end %>

    <% if @recording %>
      <% card.footer do %>
        <%= recording_studio_downloadable_button(@recording) %>
      <% end %>
    <% end %>
  <% end %>
</div>
