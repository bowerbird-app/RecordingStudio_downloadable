<%= render FlatPack::TopNav::Component.new do |nav| %>
  <% nav.left do %>
    <%= render FlatPack::Button::Component.new(
      icon: "menu",
      icon_only: true,
      style: :ghost,
      size: :md,
      aria: { label: "Toggle sidebar" },
      data: {
        "flat-pack--sidebar-layout-target": "mobileToggle",
        action: "click->flat-pack--sidebar-layout#toggleMobile"
      },
      class: "md:hidden"
    ) %>
    <%= flat_pack_page_nav_tag %>
  <% end %>

  <% nav.center do %>
    <% if user_signed_in? %>
      <%= recording_studio_root_switch_dropdown(style: :ghost, size: :md) %>
    <% end %>
  <% end %>

  <% nav.right do %>
    <%= content_for(:page_nav_right) %>
    <%= page_nav_button_group(
      styles: {
        primary: { style: :ghost, size: :sm },
        secondary: { style: :ghost, size: :sm },
        destructive: { style: :ghost, size: :sm }
      },
      variant: :outlined,
      collapse: :menu
    ) %>
    <% if user_signed_in? %>
      <%= render FlatPack::Avatar::Component.new(
        name: current_user.try(:name).presence || current_user.email,
        size: :sm
      ) %>
    <% end %>
  <% end %>
<% end %>
