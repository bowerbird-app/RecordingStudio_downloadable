<% dummy_page_nav(title: "Pages", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Pages",
    subtitle: "Page recordables in this dummy. Downloadable is opted in on Workspace, not Page — use Home for the ZIP control.",
    variant: :h1
  ) %>

  <% if @pages.any? %>
    <%= render FlatPack::List::Component.new(divider: true) do %>
      <% @pages.each do |page| %>
        <% recording = RecordingStudio::Recording.find_by(recordable: page, trashed_at: nil) %>
        <% parent = recording&.parent_recording&.recordable %>
        <%= render FlatPack::List::Item.new(icon: :type) do %>
          <div class="flex flex-col gap-1">
            <span><%= page.title.presence || "Untitled page" %></span>
            <span class="text-sm text-(--surface-muted-content-color)">
              <% if recording %>
                Recording <%= recording.id %>
                <% if parent %>
                  • under <%= parent.try(:name).presence || parent.try(:title).presence || parent.class.name %>
                <% end %>
                • Downloadable: <%= recording.downloadable? %>
              <% else %>
                No recording yet
              <% end %>
            </span>
            <span class="text-sm">
              <%= link_to "Recordings tree", docs_recordings_tree_path, class: "underline" %>
              <% if recording && defined?(recording_studio_attachable) %>
                · <%= link_to "Attachments", recording_studio_attachable.recording_attachments_path(recording), class: "underline" %>
              <% end %>
              · <%= link_to "Workspace ZIP", root_path, class: "underline" %>
            </span>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <p class="text-sm text-(--surface-muted-content-color)">
      No pages yet. Seed the dummy app to create “Getting Started”.
    </p>
  <% end %>
</div>
