<% dummy_page_nav(title: "Pages", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Pages",
      subtitle: "Page recordables in this dummy. New pages are recorded under Product Docs (or Studio Workspace), then open Attachable upload.",
      variant: :h1,
      class: "mb-0 pb-0"
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "New",
      style: :primary,
      size: :md,
      href: new_page_path
    ) %>
  </div>

  <% if @page_rows.any? %>
    <%= render FlatPack::Table::Component.new(data: @page_rows, class: "text-sm") do |table| %>
      <% table.column(title: "Title") { |row| row[:title] } %>
      <% table.column(title: "Description") { |row| row[:description] } %>
      <% table.column(title: "Downloadable") { |row| row[:downloadable] ? "yes" : "no" } %>
      <% table.column(title: "Actions") do |row| %>
        <% recording = row[:recording] %>
        <span class="flex flex-wrap gap-2">
          <% if recording %>
            <%= render FlatPack::Button::Component.new(
              text: "Upload",
              style: :primary,
              size: :sm,
              href: recording_studio_attachable.recording_attachment_upload_path(recording)
            ) %>
            <%= render FlatPack::Button::Component.new(
              text: "Attachments",
              style: :secondary,
              size: :sm,
              href: recording_studio_attachable.recording_attachments_path(recording)
            ) %>
            <% if recording.downloadable? %>
              <%= recording_studio_downloadable_button(recording, style: :ghost, size: :sm) %>
            <% end %>
          <% else %>
            <span class="text-(--surface-muted-content-color)">No recording</span>
          <% end %>
        </span>
      <% end %>
    <% end %>
  <% else %>
    <p class="text-sm text-(--surface-muted-content-color)">
      No pages yet. Use New, or seed the dummy app to create “Getting Started”.
    </p>
  <% end %>
</div>
